# Verible Verilog Format Configuration
# Документация: https://github.com/chipsalliance/verible

# ============================================================================
# Общие настройки
# ============================================================================

# Целевая ширина строки (символов)
--column_limit=100

# Количество пробелов для каждого уровня отступа
--indentation_spaces=4

# Количество пробелов для каждого уровня переноса строки
--wrap_spaces=4

# Тип окончания строки: auto, cr, crlf
--line_terminator=auto

# ============================================================================
# Выравнивание (alignment)
# Возможные значения: align, flush-left, preserve, infer
# ============================================================================

# Выравнивание различных присваиваний
--assignment_statement_alignment=align

# Выравнивание элементов case
--case_items_alignment=align

# Выравнивание переменных-членов класса
--class_member_variable_alignment=align

# Выравнивание элементов distribution
--distribution_items_alignment=align

# Выравнивание присваиваний с enum
--enum_assignment_statement_alignment=align

# Выравнивание формальных параметров
--formal_parameters_alignment=align

# Выравнивание объявлений net/variable
--module_net_variable_alignment=align

# Выравнивание именованных параметров
--named_parameter_alignment=align

# Выравнивание именованных портов
--named_port_alignment=align

# Выравнивание объявлений портов
--port_declarations_alignment=align

# Выравнивание членов struct/union
--struct_union_members_alignment=align

# ============================================================================
# Отступы (indentation)
# Возможные значения: indent, wrap
# ============================================================================

# Отступ формальных параметров
--formal_parameters_indentation=wrap

# Отступ именованных параметров
--named_parameter_indentation=wrap

# Отступ именованных портов
--named_port_indentation=wrap

# Отступ объявлений портов
--port_declarations_indentation=wrap

# ============================================================================
# Дополнительные настройки
# ============================================================================

# Использовать компактные бинарные выражения внутри операторов индексации
--compact_indexing_and_selections=true

# Всегда разворачивать coverpoints
--expand_coverpoints=false

# Выравнивать упакованные размеры справа (при включенном выравнивании)
--port_declarations_right_align_packed_dimensions=false

# Выравнивать неупакованные размеры справа (при включенном выравнивании)
--port_declarations_right_align_unpacked_dimensions=false

# Попытка оптимизировать перенос длинных строк
--try_wrap_long_lines=true

# Разделять end и else на отдельные строки
--wrap_end_else_clauses=false

# ============================================================================
# Настройки проверки и обработки ошибок
# ============================================================================

# Продолжать работу даже при ошибках (сохраняет исходный текст)
--failsafe_success=true

# Проверять сходимость форматирования (повторное форматирование не меняет результат)
--verify_convergence=true

# Ограничение количества состояний поиска при оптимизации переноса строк
--max_search_states=100000
